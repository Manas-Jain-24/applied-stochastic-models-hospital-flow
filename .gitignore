# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDEs and Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System files
Thumbs.db
Desktop.ini
.DS_Store

# Large Raw Data Files (> 50-100MB exceed GitHub file limits)
# Raw CSV datasets in the repository root or data directory
*.csv
*.tsv
*.xlsx
*.parquet
*.zip
*.tar.gz
*.gz

# Allow small processed/sample datasets if explicitly placed in data/processed/
!data/processed/.gitkeep
!data/sample/.gitkeep
